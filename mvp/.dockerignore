# This .dockerignore is used when building semantic-search-service with mvp context

# Frontend - not needed for backend build
frontend/

# BFF - not needed for semantic search build
backend/BFF/

# Other backend services
backend/postgres-app/
backend/postgres-semantic/

# Docker compose files
docker-compose*.yml
*.yml

# Scripts (exclude all except backup scripts needed by semantic-search-service)
scripts/dev/
scripts/test/
scripts/setup/
scripts/utils/
*.bat
*.sh

# Documentation
*.md
docs/

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python cache (in case any exists at root)
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment files
.env
.env.*

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
nul

# Test files
test-setup.bat
run-tests.bat
run-tests.sh

# Local development scripts
run-local.bat
run-local.sh
run-docker.bat
run-docker.sh
