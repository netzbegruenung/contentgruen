# Local Development Environment Configuration
# Copy this file to .env and adjust values as needed

# Environment type - set to false for local development
DOCKER_CONTAINER=false

# Database configuration
SEMANTIC_SEARCH_PGVECTOR_URL=postgresql+psycopg2://semantic_search:changeme@localhost:5432/semantic_search
APP_DATABASE_URL=postgresql+psycopg2://app_user:changeme@localhost:5433/gutgesagt_app

# Path configuration for local development
# These paths are relative to the project root
SEMANTIC_SEARCH_DATA_PATH=./data/seed/v1.0
SEMANTIC_SEARCH_METADATA_PATH=./temp_data/metadata

# Logging configuration
SEMANTIC_SEARCH_LOG_LEVEL=INFO
SEMANTIC_SEARCH_LOG_FILE=

# Admin users (comma-separated list of user IDs)
SEMANTIC_SEARCH_ADMIN_USERS=

# Startkonten (comma-separated user IDs of Beta-Zugaenge, #352): their usage is
# not counted, their votes count nowhere, they collect no points.
SEMANTIC_SEARCH_STARTKONTEN=

# Points (ADR 0004, #352). Off by default: only switch on once the consent at first
# login names points as a purpose and the privacy policy has the section (#374, #222).
# Weights and daily caps: see core/config.py (SEMANTIC_SEARCH_PUNKTE_*).
SEMANTIC_SEARCH_PUNKTE_AKTIV=false

# Usage tracking and cleanup
SEMANTIC_SEARCH_ENABLE_USAGE_CLEANUP=true
SEMANTIC_SEARCH_USAGE_RETENTION_DAYS=90
# Search events: single rows for this many days, then day counters only (min. 90)
SEMANTIC_SEARCH_SEARCH_EVENT_RETENTION_DAYS=90
