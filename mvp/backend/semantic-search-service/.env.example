# Local Development Environment Configuration
# Copy this file to .env and adjust values as needed

# Environment type - set to false for local development
DOCKER_CONTAINER=false

# Database configuration
SEMANTIC_SEARCH_PGVECTOR_URL=postgresql+psycopg2://semantic_search:changeme@localhost:5432/semantic_search
APP_DATABASE_URL=postgresql+psycopg2://app_user:changeme@localhost:5433/gutgesagt_app

# Path configuration for local development
# These paths are relative to the project root
SEMANTIC_SEARCH_DATA_PATH=./data/seed/v1.0
SEMANTIC_SEARCH_METADATA_PATH=./temp_data/metadata

# Torch-Threads fuer Einbettungen (#480); ohne Angabe einer je sichtbarem Kern.
# Begrenzt auf einem ausgelasteten Host das gegenseitige Ausbremsen. Nicht leer setzen.
# SEMANTIC_SEARCH_EMBEDDING_THREADS=2

# Logging configuration
SEMANTIC_SEARCH_LOG_LEVEL=INFO
SEMANTIC_SEARCH_LOG_FILE=

# Admin users (comma-separated list of user IDs)
SEMANTIC_SEARCH_ADMIN_USERS=

# Startkonten (comma-separated user IDs of Beta-Zugaenge, #352): their usage is
# not counted, their votes count nowhere, they collect no points.
SEMANTIC_SEARCH_STARTKONTEN=

# Points (ADR 0004, #352). Off by default. ONLY SWITCH ON AFTER #668 IS MERGED: points and
# milestones need their own voluntary consent "Punkte und Meilensteine" (not the Art. 9
# consent since wording 2026-11-13); until then the service refuses to start with it on.
# Weights and daily caps: see core/config.py (SEMANTIC_SEARCH_PUNKTE_*).
SEMANTIC_SEARCH_PUNKTE_AKTIV=false
# Milestone badges next to the display name for other signed-in people (#351). Off by
# default and only effective together with PUNKTE_AKTIV; each person must also agree to
# the visibility. Switch on only after the DSFA (docs/DSFA.md, V22) and the privacy policy.
SEMANTIC_SEARCH_ABZEICHEN_SICHTBAR_AKTIV=false
# "Ja, gepostet" after copying (#643): signed-in people with Art. 9 consent report that
# they posted a reply; counted once per person and calendar week, without the Beitrag.
# Off by default; switch on only after the DSFA and the privacy policy name it.
SEMANTIC_SEARCH_GEPOSTET_AKTIV=false

# Rate limit of POST /usage/content/{id}/usage (#352): copies per person (visitors:
# per address) within the window.
SEMANTIC_SEARCH_NUTZUNG_RATE_LIMIT_ANFRAGEN=60
SEMANTIC_SEARCH_NUTZUNG_RATE_LIMIT_MINUTEN=10

# Einladungen einloesen (#429): Konten im Realm von Gut gesagt anlegen.
# Ohne URL, Client und Secret lassen sich Einladungen nur verwalten. docs/KEYCLOAK_REALM.md
# Erst zusammen mit dem Wechsel der BFF auf den neuen Realm setzen (Reihenfolge dort).
SEMANTIC_SEARCH_KEYCLOAK_URL=
SEMANTIC_SEARCH_KEYCLOAK_REALM=gutgesagt
SEMANTIC_SEARCH_KEYCLOAK_ADMIN_CLIENT_ID=
SEMANTIC_SEARCH_KEYCLOAK_ADMIN_CLIENT_SECRET=
SEMANTIC_SEARCH_KEYCLOAK_APP_CLIENT_ID=
SEMANTIC_SEARCH_APP_URL=

# Der taegliche Bereinigungsjob (Frist der Nutzungsereignisse); frueher ENABLE_USAGE_CLEANUP, das gilt weiter.
# Suchereignisse werden am Tagesende verdichtet, unabhaengig von diesem Schalter (#495).
SEMANTIC_SEARCH_ENABLE_BEREINIGUNGSJOB=true
SEMANTIC_SEARCH_USAGE_RETENTION_DAYS=90
